---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.svelte';
import TorrentCard from '../components/TorrentCard.svelte';
import { buildMagnetLink, type TorrentStream } from '../lib/server/services/torrent';

const query = Astro.url.searchParams.get('query');
let links: { torrent: string; source: string }[] = [];

if (query) {
	const { services } = Astro.locals;
	const searchResults = await services.search.search(query);

	const refererMap = new Map(searchResults.map((r) => [r.link, r.source]));
	const rankedLinks = services.rank.rank(searchResults.map((r) => r.link));
	// Match scraper: only scrape the best candidates to avoid rate limits and junk domains
	const topLinks = rankedLinks.slice(0, 10);

	const sourceReferers: Record<string, string> = {
		Google: 'https://www.google.com/',
		DuckDuckGo: 'https://duckduckgo.com/',
		Yandex: 'https://yandex.com/'
	};

	const fetched = await Promise.all(
		topLinks.map(async (url) => {
			const source = refererMap.get(url);
			const referer = source ? sourceReferers[source] : undefined;
			const streams = await services.scraper.fetchTorrentsInSite(url, referer).catch((e) => {
				services.error.report(e, { url, message: 'fetchTorrentsInSite failed' });
				return [] as TorrentStream[];
			});
			return streams.map((s) => ({ stream: s, source: source ?? '' }));
		})
	);

	// Dedupe by infoHash and union trackers so the UI keeps announce URLs.
	const byHash = new Map<string, { stream: TorrentStream; source: string }>();
	for (const { stream, source } of fetched.flat()) {
		const existing = byHash.get(stream.infoHash);
		if (!existing) {
			byHash.set(stream.infoHash, {
				stream: { ...stream, trackers: [...stream.trackers] },
				source
			});
			continue;
		}
		const seen = new Set(existing.stream.trackers);
		for (const tr of stream.trackers) {
			if (!seen.has(tr)) {
				seen.add(tr);
				existing.stream.trackers.push(tr);
			}
		}
	}
	links = Array.from(byHash.values()).map(({ stream, source }) => ({
		torrent: buildMagnetLink(stream),
		source
	}));
}

const pageTitle = query ? `${query} - pesquisarr` : 'pesquisarr';
---

<Layout title={pageTitle}>
	<div class="flex flex-col gap-4">
		<div class="sticky top-0 bg-base-100 py-4 z-10">
			<SearchBar client:load initialQuery={query ?? ''} />
		</div>

		<div class="space-y-4">
			{
				links && links.length > 0 ? (
					links.map((item) => <TorrentCard torrent={item.torrent} />)
				) : query ? (
					<div class="text-center py-10">
						<p class="text-xl">Nenhum resultado encontrado para "{query}"</p>
					</div>
				) : null
			}
		</div>
	</div>
</Layout>
