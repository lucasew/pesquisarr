---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.svelte';
import TorrentCard from '../components/TorrentCard.svelte';

const query = Astro.url.searchParams.get('query');
let links: { torrent: string; source: string }[] = [];

if (query) {
	const { services } = Astro.locals;
	const searchResults = await services.search.search(query);

	const fetched = await Promise.all(
		searchResults.map(async (r) => {
			const streams = await services.scraper.fetchTorrentsInSite(r.link).catch(() => []);
			return streams.map((s) => {
				let magnet = `magnet:?xt=urn:btih:${s.infoHash}`;
				if (s.title) {
					magnet += `&dn=${encodeURIComponent(s.title)}`;
				}
				return { magnet, source: r.source };
			});
		})
	);

	const entries = fetched.flat();
	const map = new Map<string, string>();
	for (const { magnet, source } of entries) {
		if (!map.has(magnet)) map.set(magnet, source);
	}
	links = Array.from(map.entries()).map(([torrent, source]) => ({ torrent, source }));
}

const pageTitle = query ? `${query} - pesquisarr` : 'pesquisarr';
---

<Layout title={pageTitle}>
	<div class="flex flex-col gap-4">
		<div class="sticky top-0 bg-base-100 py-4 z-10">
			<SearchBar client:load initialQuery={query ?? ''} />
		</div>

		<div class="space-y-4">
			{
				links && links.length > 0 ? (
					links.map((item) => <TorrentCard torrent={item.torrent} />)
				) : query ? (
					<div class="text-center py-10">
						<p class="text-xl">Nenhum resultado encontrado para "{query}"</p>
					</div>
				) : null
			}
		</div>
	</div>
</Layout>
