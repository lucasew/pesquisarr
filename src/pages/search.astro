---
import Layout from '../layouts/Layout.astro';
import SearchBar from '../components/SearchBar.svelte';
import TorrentCard from '../components/TorrentCard.svelte';
import { buildMagnetLink, type TorrentStream } from '../lib/server/services/torrent';

const query = Astro.url.searchParams.get('query');
let streams: TorrentStream[] = [];

if (query) {
	const { services } = Astro.locals;
	// Rank/scrape/dedupe lives on SearchService — same pipeline the page used to
	// inline (and that ScraperService.getTorrentStreams still mirrors for IMDb).
	streams = await services.search.searchAndScrape(query);
}

const pageTitle = query ? `${query} - pesquisarr` : 'pesquisarr';
---

<Layout title={pageTitle}>
	<div class="flex flex-col gap-4">
		<div class="sticky top-0 bg-base-100 py-4 z-10">
			<SearchBar client:load initialQuery={query ?? ''} />
		</div>

		<div class="space-y-4">
			{
				streams.length > 0 ? (
					streams.map((stream) => (
						<TorrentCard
							title={stream.title}
							infoHash={stream.infoHash}
							trackers={stream.trackers}
							href={buildMagnetLink(stream)}
						/>
					))
				) : query ? (
					<div class="text-center py-10">
						<p class="text-xl">Nenhum resultado encontrado para "{query}"</p>
					</div>
				) : null
			}
		</div>
	</div>
</Layout>
