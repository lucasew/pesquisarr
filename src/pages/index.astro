---
import Layout from '../layouts/Layout.astro';
import SearchBox from '../components/SearchBox.svelte';

const suggestion = Astro.locals.services.suggestions.getRandomSuggestion();
---

<Layout>
	<div class="flex flex-col items-center justify-center min-h-[60vh] gap-8">
		<img src="/logo.png" alt="pesquisarr" class="max-w-[300px] w-full" />
		<SearchBox client:load suggestion={suggestion} />
	</div>
</Layout>
